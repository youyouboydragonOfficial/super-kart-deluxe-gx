{
  "name": "super-kart-deluxe-gx",
  "version": "1.0.0",
  "description": "SUPER KART DELUXE GX - マリオカート完全再現＋オリジナル超ギミックエディション Windows App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "author": "Antigravity & User",
  "license": "MIT",
  "build": {
    "appId": "com.superkart.deluxegx",
    "productName": "SuperKartDeluxeGX",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SuperKartDeluxeGX-Setup-Installer-v1.0.0.exe"
    },
    "portable": {
      "artifactName": "SuperKartDeluxeGX-Portable-NoInstall-v1.0.0.exe"
    }
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  }
}
