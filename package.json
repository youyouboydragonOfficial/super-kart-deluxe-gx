{
  "name": "super-kart-deluxe-gx",
  "version": "1.0.0",
  "description": "SUPER KART DELUXE GX - マリオカート完全再現＋オリジナル超ギミックエディション Windows App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable dir"
  },
  "author": "Antigravity & User",
  "license": "MIT",
  "build": {
    "appId": "com.superkart.deluxegx",
    "productName": "SuperKartDeluxeGX",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "SuperKartDeluxeGX-Portable-v1.0.0.exe"
    }
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  }
}
